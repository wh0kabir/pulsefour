---
import Layout from '../layouts/Layout.astro';
import PulseLine from '../components/PulseLine.astro';
import Console from '../ui/console/Console';

import graph from '../../public/data/graph.json';
import hospitalFile from '../../public/data/hospitals.json';
import scenario from '../../public/data/scenario-parel.json';

const casualtyCount = scenario.casualtySchedule.reduce((n, w) => n + w.count, 0);
const fleetSize = scenario.fleet.als + scenario.fleet.bls;
---

<!-- quietBackground: the aurora stays off the console so the map stays crisp (section 14). -->
<Layout title="Console — Pulse" quietBackground>
  <header
    class="flex items-center gap-4 border-b border-hairline px-6 py-3"
  >
    <a class="flex items-center gap-3" href="/">
      <PulseLine class="h-6 w-20" />
      <span class="font-display text-base font-semibold">Pulse</span>
    </a>
    <span class="text-sm text-mist">Parel crowd crush</span>
    <span class="ml-auto text-xs text-mist">
      Simulation on real OpenStreetMap streets
    </span>
  </header>

  <main>
    <!-- The single React island (locked decision 12). -->
    <Console client:load />

    <!--
      The console is a client-side island, so without JavaScript this page is
      otherwise blank. This says what it would have shown, for a reader with
      scripting off and for anything fetching the page without a browser.
      The machine-readable version lives at /llms.txt and /llms-full.txt.
    -->
    <noscript>
      <div class="mx-auto max-w-2xl px-6 py-16">
        <h1 class="font-display text-2xl font-medium">The console needs JavaScript</h1>
        <p class="mt-4 text-sm leading-relaxed text-mist">
          Pulse runs its whole simulation in your browser — there is no backend — so the
          console cannot render without scripting. Everything it would show is described
          below and in the files linked at the end.
        </p>

        <h2 class="mt-8 font-display text-lg font-medium">What it does</h2>
        <p class="mt-3 text-sm leading-relaxed text-mist">
          A simulated mass-casualty event at Parel: {casualtyCount} casualties over
          {scenario.casualtySchedule.length} waves, a deliberately insufficient fleet of {fleetSize}
          ambulances, and {hospitalFile.meta.hospitalCount} hospitals. Every simulated minute Pulse decides
          which ambulance goes to which casualty and which hospital each one goes to, then
          re-decides as roads close and hospitals fill. Each recommendation records the
          travel times, hospital load penalty and severity weight it used, and every
          decision is appended to a SHA-256 hash chain.
        </p>

        <h2 class="mt-8 font-display text-lg font-medium">What is real</h2>
        <p class="mt-3 text-sm leading-relaxed text-mist">
          The street network and hospital locations, from OpenStreetMap:
          {graph.meta.nodeCount.toLocaleString()} junctions and {graph.meta.edgeCount.toLocaleString()} road segments
          across South Mumbai's eastern spine. Routing runs on that real graph. Casualties,
          ambulances, bed counts and supplies are simulated, and every simulated field is
          badged as such in the interface.
        </p>

        <h2 class="mt-8 font-display text-lg font-medium">Read it without a browser</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-mist">
          <li><a class="text-ice-500 underline" href="/llms.txt">/llms.txt</a> — short index</li>
          <li>
            <a class="text-ice-500 underline" href="/llms-full.txt">/llms-full.txt</a> — the whole
            project as plain text, including the assumptions register and measured results
          </li>
          <li><a class="text-ice-500 underline" href="/about">/about</a> — renders without JavaScript</li>
          <li>
            <a class="text-ice-500 underline" href="/data/graph.json">/data/graph.json</a>,
            <a class="text-ice-500 underline" href="/data/hospitals.json">hospitals.json</a>,
            <a class="text-ice-500 underline" href="/data/scenario-parel.json">scenario-parel.json</a>
          </li>
        </ul>
      </div>
    </noscript>
  </main>
</Layout>
