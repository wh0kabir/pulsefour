---
import '../styles/global.css';
import HonestyFooter from '../components/HonestyFooter.astro';

interface Props {
  title: string;
  description?: string;
  /** The console suppresses the drifting aurora so the map stays crisp (section 14). */
  quietBackground?: boolean;
}

const {
  title,
  description = 'A control-room tool that stops mass-casualty patients all going to the nearest hospital, shows its reasoning, and keeps a record nobody can quietly edit.',
  quietBackground = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-dvh bg-matte text-frost antialiased">
    {!quietBackground && <div class="aurora" aria-hidden="true"></div>}
    <slot />
    <HonestyFooter />
  </body>
</html>
